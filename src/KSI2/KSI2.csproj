<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>KSI2</AssemblyName>
    <RootNamespace>KSI2</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NeedsKsaReferences>true</NeedsKsaReferences>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Layout\PilotLayoutDefaults.json" LogicalName="KSI2.Layout.PilotLayoutDefaults.json" />
    <Content Include="Layout\PilotLayoutDefaults.json" Link="ksi2.layout.defaults.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="assets\shaders\*.vert;assets\shaders\*.frag">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(MSBuildProjectDirectory)\assets\fonts\*.ttf;$(MSBuildProjectDirectory)\assets\fonts\*.otf" Condition="Exists('$(MSBuildProjectDirectory)\assets\fonts')">
      <Link>assets\fonts\%(Filename)%(Extension)</Link>
      <TargetPath>assets\fonts\%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <PackageReference Include="StarMap.API" Version="0.3.6" />
    <ProjectReference Include="../KSI2.HudMenuPatch/KSI2.HudMenuPatch.csproj" ReferenceOutputAssembly="false" />
    <Content Include="../KSI2.HudMenuPatch/bin/$(Configuration)/net10.0/0Harmony.dll">
      <Link>assets/optional/0Harmony.dll</Link>
      <TargetPath>assets/optional/0Harmony.dll</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../KSI2.HudMenuPatch/bin/$(Configuration)/net10.0/KSI2.HudMenuPatch.dll">
      <Link>assets/optional/KSI2.HudMenuPatch.dll</Link>
      <TargetPath>assets/optional/KSI2.HudMenuPatch.dll</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(NuGetPackageRoot)lib.harmony/2.4.2/LICENSE">
      <Link>assets/optional/Harmony.LICENSE.txt</Link>
      <TargetPath>assets/optional/Harmony.LICENSE.txt</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Reference Include="$(KsaReferencePath)\Planet.Render.Core.dll" Private="false" Condition="'$(UseKsaReferencePackage)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <None Update="mod.toml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="KSI2Assets.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
